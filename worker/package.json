{
  "name": "crdt-worker",
  "version": "0.1.0",
  "private": true,
  "description": "스냅샷 워커: Redis Streams 편집 기록을 MinIO 스냅샷으로 저장하고 오래된 기록을 정리",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/snapshot.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "ioredis": "^5.11.1",
    "prom-client": "^15.1.3",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
