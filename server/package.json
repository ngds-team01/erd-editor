{
  "name": "crdt-server",
  "version": "0.1.0",
  "private": true,
  "description": "Yjs 편집 서버 (y-websocket 프로토콜, /ws/{docId})",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
